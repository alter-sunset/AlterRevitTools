<mvvm:WindowBase x:Class="AlterTools.atLink.WindowMain"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:local="clr-namespace:AlterTools.atLink"
                 xmlns:resx="clr-namespace:AlterTools.Resources;assembly=Resources"
                 xmlns:mvvm="clr-namespace:AlterTools.Utils.MVVM;assembly=Utils"
                 xmlns:atLink="clr-namespace:AlterTools.atLink"
                 mc:Ignorable="d"
                 Height="500"
                 Width="800"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 Title="{x:Static resx:Strings.LinkTitle}"
                 IsEnabled="{Binding IsViewEnabled}"
                 ShowInTaskbar="False">
    <Window.InputBindings>
        <!-- The CommandParameter feeds the real UI selection list to your backend -->
        <KeyBinding Key="Delete"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=FilesListBox}" />
    </Window.InputBindings>
    <Grid Background="WhiteSmoke">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="300" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- 1 -->
        <CheckBox Margin="10,0,10,0"
                  Grid.Column="0"
                  Grid.Row="0"
                  VerticalAlignment="Center"
                  Content="{x:Static resx:Strings.PinLinks}"
                  IsChecked="{Binding PinLinks}" />
        <TextBlock Margin="10 0"
                   FontSize="12"
                   Grid.Row="0"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{x:Static resx:Strings.WorksetPrefixes}" />
        <TextBox Margin="10 10"
                 Grid.Row="0"
                 Grid.Column="2"
                 Grid.ColumnSpan="2"
                 Height="30"
                 VerticalContentAlignment="Center"
                 Text="{Binding WorksetPrefix}"
                 ToolTip="{x:Static resx:Strings.WorksetPrefixesToolTip}" />

        <!-- 2 -->
        <CheckBox Margin="10,0,100,0"
                  Grid.Column="0"
                  Grid.Row="1"
                  VerticalAlignment="Center"
                  Content="{x:Static resx:Strings.LinkCurrentWorkset}"
                  Grid.ColumnSpan="2"
                  IsChecked="{Binding IsCurrentWorkset}" />
        <!-- 3 -->
        <TextBlock
            Grid.Row="2"
            Margin="10,0,10,0"
            FontSize="14"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            VerticalAlignment="Center"
            Text="{x:Static resx:Strings.LinkHeader}" />

        <!-- 4 -->
        <ListBox
            x:Name="FilesListBox"
            Grid.Row="3"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Margin="10"
            Width="760"
            SelectionMode="Extended"
            ItemsSource="{Binding Entries}"
            SelectedItem="{Binding SelectedEntry}"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            HorizontalContentAlignment="Left"
            SelectionChanged="ListBox_SelectionChanged"
            ToolTip="{x:Static resx:Strings.ListBoxToolTip}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="atLink:Entry">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}"
                                   Grid.Column="0"
                                   TextWrapping="NoWrap" />
                        <ComboBox
                            Margin="10,0,10,0"
                            Grid.Column="1"
                            SelectedItem="{Binding SelectedWorkset, Mode=TwoWay}"
                            ItemsSource="{Binding Worksets}"
                            DisplayMemberPath="Name" />
                        <ComboBox
                            Width="70"
                            SelectedItem="{Binding SelectedImportPlacement, Mode=TwoWay}"
                            ItemsSource="{Binding ImportPlacements}"
                            Grid.Column="2" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 5 -->
        <Button Margin="10"
                Grid.Column="0"
                Grid.Row="4"
                Height="30"
                Width="100"
                HorizontalAlignment="Left"
                Command="{Binding LoadCommand}"
                Content="{x:Static resx:Strings.Load}"
                ToolTip="{x:Static resx:Strings.LoadToolTip}" />
        <Button Margin="10"
                Grid.Column="1"
                Grid.Row="4"
                Height="30"
                Width="100"
                HorizontalAlignment="Right"
                Command="{Binding LoadListCommand}"
                Content="{x:Static resx:Strings.Import}" />
        <Button Margin="10"
                Grid.Column="2"
                Grid.Row="4"
                Height="30"
                Width="100"
                HorizontalAlignment="Left"
                Command="{Binding SaveListCommand}"
                Content="{x:Static resx:Strings.Export}" />
        <Button Margin="10"
                Grid.Row="4"
                Grid.Column="3"
                Height="30"
                Width="100"
                HorizontalAlignment="Right"
                Command="{Binding ExecuteCommand}"
                Content="{x:Static resx:Strings.Start}" />
    </Grid>
</mvvm:WindowBase>