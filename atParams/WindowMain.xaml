<mvvm:WindowBase x:Class="AlterTools.atParams.WindowMain"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:resx="clr-namespace:AlterTools.Resources;assembly=Resources"
                 xmlns:mvvm="clr-namespace:AlterTools.Utils.MVVM;assembly=Utils"
                 mc:Ignorable="d"
                 IsEnabled="{Binding IsViewEnabled}"
                 ShowInTaskbar="False"
                 Height="500"
                 Width="800"
                 WindowStartupLocation="CenterScreen"
                 ResizeMode="NoResize"
                 Title="{x:Static resx:Strings.ParamsTitle}">
    <Window.InputBindings>
        <!-- The CommandParameter feeds the real UI selection list to your backend -->
        <KeyBinding Key="Delete"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding (ListBox.SelectedItems), ElementName=FilesListBox}" />
    </Window.InputBindings>
    <Grid Background="WhiteSmoke">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="300" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!-- 1 -->
        <TextBlock Margin="10,0,40,0"
                   FontSize="12"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.PathToResultingFile}" />
        <TextBox Grid.Column="0" Margin="165,10,135,10"
                 Grid.Row="0"
                 Grid.ColumnSpan="4"
                 VerticalContentAlignment="Center"
                 Text="{Binding CsvPath}"
                 ToolTip="{x:Static resx:Strings.PathToResultingFileToolTip}" />
        <Button Margin="80,10,10,10"
                Grid.Column="3"
                Grid.Row="0"
                Command="{Binding BrowseCsvCommand}"
                Content="{x:Static resx:Strings.Browse}" />

        <!-- 2 -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            FontSize="12"
            Margin="10,0,40,0"
            VerticalAlignment="Center"
            TextWrapping="Wrap"
            Text="{x:Static resx:Strings.ParamsToExport}" />
        <TextBox
            Grid.Column="0"
            Grid.Row="1"
            Grid.ColumnSpan="4"
            Margin="165,10,10,10"
            VerticalContentAlignment="Center"
            Text="{Binding ParamsNames}"
            ToolTip="{x:Static resx:Strings.ParamsToExportToolTip}" />

        <!-- 3 -->
        <ListBox
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Margin="10"
            SelectionMode="Extended"
            ItemsSource="{Binding Files}"
            ToolTip="{x:Static resx:Strings.ListBoxToolTip}" />

        <!-- 4 -->
        <Button
            x:Name="FilesListBox"
            Margin="10"
            Grid.Column="0"
            Grid.Row="3"
            Height="30"
            Width="100"
            HorizontalAlignment="Left"
            Command="{Binding LoadCommand}"
            Content="{x:Static resx:Strings.Load}"
            ToolTip="{x:Static resx:Strings.LoadToolTip}" />
        <Button
            Grid.Column="1"
            Grid.Row="3"
            Margin="10"
            Height="30"
            Width="100"
            HorizontalAlignment="Right"
            Command="{Binding LoadListCommand}"
            Content="{x:Static resx:Strings.Import}" />
        <Button
            Grid.Column="2"
            Grid.Row="3"
            Margin="10"
            Height="30"
            Width="100"
            HorizontalAlignment="Left"
            Command="{Binding SaveListCommand}"
            Content="{x:Static resx:Strings.Export}" />
        <Button
            Grid.Row="3"
            Grid.Column="3"
            Margin="10"
            Height="30"
            Width="100"
            HorizontalAlignment="Right"
            Command="{Binding ExecuteCommand}"
            Content="{x:Static resx:Strings.Start}"
            ToolTip="{x:Static resx:Strings.StartToolTip}" />
    </Grid>
</mvvm:WindowBase>