<Window x:Class="AlterTools.atExportModel.UI.WindowIFC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:resx="clr-namespace:AlterTools.Resources;assembly=Resources"
        mc:Ignorable="d"
        Title="WindowIFC"
        Height="560"
        Width="1120"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="310" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Общие -->
        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Margin="10 0"
            Header="Общие"
            Background="WhiteSmoke">
            <Grid Margin="10 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1 -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Версия IFC"
                    TextAlignment="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="25"
                    Margin="10 0 "
                    ItemsSource="{Binding IFCVersions}"
                    SelectedItem="{Binding SelectedIFCVersion}"
                    DisplayMemberPath="Value" />

                <!-- 2 -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="Тип файла"
                    TextAlignment="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="25"
                    Margin="10 0 "
                    ItemsSource="{Binding IFCFileTypes}"
                    SelectedItem="{Binding SelectedIFCFileType}"
                    DisplayMemberPath="Value" />

                <!-- 3 -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="Граница пространств"
                    TextAlignment="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Height="25"
                    Margin="10 0 "
                    ItemsSource="{Binding SpaceBoundaryLevels}"
                    SelectedItem="{Binding SelectedSpaceBoundaryLevel}"
                    DisplayMemberPath="Value" />

                <!-- 4 -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Text="Координаты"
                    TextAlignment="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Height="25"
                    Margin="10 0 "
                    ItemsSource="{Binding SitePlacements}"
                    SelectedItem="{Binding SelectedSitePlacement}"
                    DisplayMemberPath="Value" />

                <!-- 5 -->
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Text="Детализация"
                    TextAlignment="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
                <ComboBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Height="25"
                    Margin="10 0 "
                    ItemsSource="{Binding LevelsOfDetail}"
                    SelectedItem="{Binding SelectedLevelOfDetail}"
                    DisplayMemberPath="Value" />
            </Grid>
        </GroupBox>

        <!-- Наборы характеристик -->
        <GroupBox
            Grid.Row="1"
            Grid.Column="0"
            Margin="10 0"
            Header="Наборы характеристик"
            Background="WhiteSmoke">
            <Grid Margin="10 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <!-- 1 -->
                <CheckBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Экспортировать наборы характеристик Revit"
                    IsChecked="{Binding ConfigAdd.ExportInternalRevitPropertySets}" />

                <!-- 2 -->
                <CheckBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Экспорт общих наборов характеристик IFC"
                    IsChecked="{Binding ConfigAdd.ExportIFCCommonPropertySets}" />

                <!-- 3 -->
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Экспорт основных величин"
                    IsChecked="{Binding Config.ExportBaseQuantities}" />

                <!-- 4 -->
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Экспорт наборов свойств материалов"
                    IsChecked="{Binding ConfigAdd.ExportMaterialPsets}" />

                <!-- 5 -->
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Экспорт спецификаций в виде наборов характеристик"
                    IsChecked="{Binding ConfigAdd.ExportSchedulesAsPsets}" />

                <!-- 6 -->
                <CheckBox
                    Grid.Row="5"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="20 0 0 0"
                    Content="Экспорт только спецификаций, заголовок которых содержит IFC, Pset или ''Общие''"
                    IsChecked="{Binding ConfigAdd.ExportSpecificSchedules}"
                    IsEnabled="{Binding ConfigAdd.ExportSchedulesAsPsets}" />

                <!-- 7 -->
                <CheckBox
                    Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Основное: экспорт пользовательских наборов характеристик"
                    IsChecked="{Binding ConfigAdd.ExportUserDefinedPsets}" />

                <!-- 8 -->
                <TextBox
                    Grid.Row="7"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="370"
                    Height="25"
                    Margin="20 0 0 0"
                    Text="{Binding ExportUserDefinedPsetsFileName}"
                    IsEnabled="{Binding ConfigAdd.ExportUserDefinedPsets}" />
                <Button
                    Grid.Row="7"
                    Grid.Column="1"
                    Height="25"
                    Content="Обзор..."
                    IsEnabled="{Binding ConfigAdd.ExportUserDefinedPsets}"
                    Command="{Binding BrowseUserDefinedPsetsCommand}" />

                <!-- 9 -->
                <CheckBox
                    Grid.Row="8"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Дополнительно: таблица соответствия параметров экспорта"
                    IsChecked="{Binding Config.UseUserMapping}" />

                <!-- 10 -->
                <TextBox
                    Grid.Row="9"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Width="370"
                    Height="25"
                    Margin="20 0 0 0"
                    Text="{Binding FamilyMappingFile}"
                    IsEnabled="{Binding Config.UseUserMapping}" />
                <Button
                    Grid.Row="9"
                    Grid.Column="1"
                    Height="25"
                    Content="Обзор..."
                    IsEnabled="{Binding Config.UseUserMapping}"
                    Command="{Binding BrowseUserMappingCommand}" />
            </Grid>
        </GroupBox>

        <!-- Дополнительные свойства -->
        <GroupBox
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="2"
            Margin="10 0 10 40"
            Header="Дополнительные свойства"
            Background="WhiteSmoke">
            <Grid Margin="10 0 ">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1 -->
                <CheckBox
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Разделить стены, колонны, воздуховоды по уровню"
                    IsChecked="{Binding Config.WallAndColumnSplitting}" />

                <!-- 2 -->
                <CheckBox
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Включить стальные элементы"
                    IsChecked="{Binding ConfigAdd.IncludeSteelElements}" />

                <!-- 3 -->
                <CheckBox
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Экспорт 2D-элементов вида в плане"
                    IsChecked="{Binding ConfigAdd.Export2DElements}" />

                <!-- 4 -->
                <CheckBox
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Экспортитровать помещения на 3D-видах"
                    IsChecked="{Binding ConfigAdd.ExportRoomsInView}" />

                <!-- 5 -->
                <CheckBox
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Экспорт деталей в качестве элементов здания"
                    IsChecked="{Binding ConfigAdd.ExportPartsAsBuildingElements}" />

                <!-- 6 -->
                <CheckBox
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Разрешить использование смешанных представлений ''Модель твёрдого тела''"
                    IsChecked="{Binding ConfigAdd.ExportSolidModelRep}" />

                <!-- 7 -->
                <CheckBox
                    Grid.Row="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Используйте активный вид при создании геометрии"
                    IsChecked="{Binding ConfigAdd.UseActiveViewGeometry}" />

                <!-- 8 -->
                <CheckBox
                    Grid.Row="7"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Используйте команду имя семейства и типоразмера для ссылки"
                    IsChecked="{Binding ConfigAdd.UseFamilyAndTypeNameForReference}" />

                <!-- 9 -->
                <CheckBox
                    Grid.Row="8"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Используйте 2D-границы помещений для параметра ''Объём помещения''"
                    IsChecked="{Binding ConfigAdd.Use2DRoomBoundaryForVolume}" />

                <!-- 10 -->
                <CheckBox
                    Grid.Row="9"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Включить отметку IFCSITE в локальное начало координат размещения площадки"
                    IsChecked="{Binding ConfigAdd.IncludeSiteElevation}" />

                <!-- 11 -->
                <CheckBox
                    Grid.Row="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Сохранить IFC GUID в параметре элемента после экспорта"
                    IsChecked="{Binding ConfigAdd.StoreIFCGUID}" />

                <!-- 12 -->
                <CheckBox
                    Grid.Row="11"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Экспорт ограничивающей рамки"
                    IsChecked="{Binding ConfigAdd.ExportBoundingBox}" />

                <!-- 13 -->
                <CheckBox
                    Grid.Row="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Сохранить мозаичную геометрию как триангуляцию"
                    IsChecked="{Binding ConfigAdd.UseOnlyTriangulation}" />

                <!-- 14 -->
                <CheckBox
                    Grid.Row="13"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Использовать имя типа только для имени IFCEntity"
                    IsChecked="{Binding ConfigAdd.UseTypeNameOnlyForIfcType}" />

                <!-- 15 -->
                <CheckBox
                    Grid.Row="14"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Content="Использовать видимое имя Revit в качестве имени IFCEntity"
                    IsChecked="{Binding ConfigAdd.UseVisibleRevitNameAsEntityName}" />
            </Grid>
        </GroupBox>

        <Button
            Grid.Row="1"
            Grid.Column="1"
            Width="100"
            Height="25"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="10 0"
            Content="OK"
            Click="Ok_OnClick" />
    </Grid>
</Window>