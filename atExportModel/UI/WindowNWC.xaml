<Window x:Class="AlterTools.atExportModel.UI.WindowNWC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:resx="clr-namespace:AlterTools.Resources;assembly=Resources"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.SettingsNWC}"
        Height="630"
        Width="450"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1 -->
        <TextBlock Grid.Row="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ExportElementIds}" />

        <CheckBox Grid.Row="0"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ExportElementIds}" />

        <!-- 2 -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertElementParams}" />

        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Width="100"
                  SelectedIndex="0"
                  HorizontalAlignment="Left"
                  Margin="5"
                  ItemsSource="{Binding Parameters}"
                  SelectedItem="{Binding SelectedParameters}"
                  DisplayMemberPath="Value" />

        <!-- 3 -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.Coordinates}" />

        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  Width="100"
                  SelectedIndex="0"
                  HorizontalAlignment="Left"
                  Margin="5"
                  ItemsSource="{Binding Coordinates}"
                  SelectedItem="{Binding SelectedCoordinates}"
                  DisplayMemberPath="Value" />

        <!-- 4 -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.FacetingFactor}" />

        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 HorizontalAlignment="Left"
                 Margin="5"
                 Width="100"
                 VerticalContentAlignment="Center"
                 Text="{Binding Config.FacetingFactor}" />

        <!-- 5 -->
        <TextBlock Grid.Row="4" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertURLs}" />

        <CheckBox Grid.Row="4"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ExportUrls}" />

        <!-- 6 -->
        <TextBlock Grid.Row="5" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertLights}" />

        <CheckBox Grid.Row="5"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ConvertLights}" />

        <!-- 7 -->
        <TextBlock Grid.Row="6" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertRoomAsAttr}" />

        <CheckBox Grid.Row="6"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ExportRoomAsAttribute}" />

        <!-- 8 -->
        <TextBlock Grid.Row="7" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertElementProperties}" />

        <CheckBox Grid.Row="7"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ConvertElementProperties}" />

        <!-- 9 -->
        <TextBlock Grid.Row="8" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertCAD}" />

        <CheckBox Grid.Row="8"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ConvertLinkedCADFormats}" />

        <!-- 10 -->
        <TextBlock Grid.Row="9" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertLinks}" />

        <CheckBox Grid.Row="9"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ExportLinks}" />

        <!-- 11 -->
        <TextBlock Grid.Row="10" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ConvertParts}" />

        <CheckBox Grid.Row="10"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ExportParts}" />

        <!-- 12 -->
        <TextBlock Grid.Row="11" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.FindMissingMaterials}" />

        <CheckBox Grid.Row="11"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.FindMissingMaterials}" />

        <!-- 13 -->
        <TextBlock Grid.Row="12" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.DivideFile}" />

        <CheckBox Grid.Row="12"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.DivideFileIntoLevels}" />

        <!-- 14 -->
        <TextBlock Grid.Row="13" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.Export}" />

        <ComboBox Grid.Row="13"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  Margin="5"
                  Width="100"
                  ItemsSource="{Binding ExportScopes}"
                  SelectedItem="{Binding SelectedExportScope}"
                  DisplayMemberPath="Value" />


        <!-- 15 -->
        <TextBlock Grid.Row="14" Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="{x:Static resx:Strings.ExportRoomGeometry}" />

        <CheckBox Grid.Row="14"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding Config.ExportRoomGeometry}" />

        <!-- OK Button -->
        <Button Grid.Row="15"
                Grid.ColumnSpan="2" Grid.Column="0"
                Content="OK"
                Width="114"
                HorizontalAlignment="Right"
                Margin="0 10 0 0"
                Click="Ok_OnClick" />
    </Grid>
</Window>