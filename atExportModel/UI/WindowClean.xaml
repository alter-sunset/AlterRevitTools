<Window x:Class="AlterTools.atExportModel.UI.WindowClean"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AlterTools.atExportModel.UI"
        mc:Ignorable="d"
        Title="ViewModelClean"
        Height="400"
        Width="550"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="10 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- 1 -->
            <CheckBox
                Grid.Row="0"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить неиспользуемые элементы" />

            <!-- 2 -->
            <CheckBox
                Grid.Row="1"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить связи САПР" />

            <!-- 3 -->
            <CheckBox
                Grid.Row="2"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить связи RVT" />

            <!-- 4 -->
            <CheckBox
                Grid.Row="3"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить пустые рабочие наборы" />

            <!-- 5 -->
            <CheckBox
                Grid.Row="4"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить все листы" />

            <!-- 6 -->
            <CheckBox
                Grid.Row="5"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить выбранные типы видов:" />
        </Grid>

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Grid.RowSpan="2"
            Margin="10"
            Background="WhiteSmoke"
            Header="Типы видов для удаления"
            IsEnabled="False">
            <Grid Margin="0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1 -->
                <CheckBox
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Все" />

                <!-- 2 -->
                <CheckBox
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="3D виды" />

                <!-- 3 -->
                <CheckBox
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Виды узлов" />

                <!-- 4 -->
                <CheckBox
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Визуализация" />

                <!-- 5 -->
                <CheckBox
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Графические спецификации колонн" />

                <!-- 6 -->
                <CheckBox
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Легенды" />

                <!-- 7 -->
                <CheckBox
                    Grid.Row="6"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Обходы" />

                <!-- 8 -->
                <CheckBox
                    Grid.Row="7"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы зонирования" />

                <!-- 9 -->
                <CheckBox
                    Grid.Row="8"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы несущих конструкций" />

                <!-- 10 -->
                <CheckBox
                    Grid.Row="9"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы потолков" />

                <!-- 11 -->
                <CheckBox
                    Grid.Row="10"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы этажей" />

                <!-- 12 -->
                <CheckBox
                    Grid.Row="11"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Разрезы" />

                <!-- 13 -->
                <CheckBox
                    Grid.Row="12"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Спецификации" />

                <!-- 14 -->
                <CheckBox
                    Grid.Row="13"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Фасады" />

                <!-- 15 -->
                <CheckBox
                    Grid.Row="14"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Чертёжные виды" />
            </Grid>
        </GroupBox>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            Width="100"
            Height="25"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="10 0"
            Content="OK"
            Click="Ok_OnClick" />
    </Grid>
</Window>