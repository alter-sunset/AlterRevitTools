<Window x:Class="AlterTools.atExportModel.UI.WindowClean"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:resx="clr-namespace:AlterTools.Resources;assembly=Resources"
        xmlns:local="clr-namespace:AlterTools.atExportModel.UI"
        mc:Ignorable="d"
        Title="{ x:Static resx:Strings.CleanSettings}"
        Height="400"
        Width="550"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="10 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- 1 -->
            <CheckBox
                Grid.Row="0"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.PurgeUnused}"
                IsChecked="{Binding Config.Purge}" />

            <!-- 2 -->
            <CheckBox
                Grid.Row="1"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.RemoveLinkedCad}"
                IsChecked="{Binding Config.RemoveLinkedCad}" />

            <!-- 3 -->
            <CheckBox
                Grid.Row="2"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.RemoveLinkedRvt}"
                IsChecked="{Binding Config.RemoveLinkedRvt}" />

            <!-- 4 -->
            <CheckBox
                Grid.Row="3"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.UnloadLinks}"
                IsChecked="{Binding Config.UnloadLinks}" />

            <!-- 5 -->
            <CheckBox
                Grid.Row="4"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.RemoveOrphanedRooms}"
                IsChecked="{Binding Config.RemoveOrphanedRooms}" />

            <!-- 6 -->
            <CheckBox
                Grid.Row="5"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.RemoveEmptyWorksets}"
                IsChecked="{Binding Config.RemoveEmptyWorksets}" />

            <!-- 7 -->
            <CheckBox
                Grid.Row="6"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.RemoveSheets}"
                IsChecked="{Binding Config.RemoveSheets}" />

            <!-- 8 -->
            <CheckBox
                Grid.Row="7"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="{ x:Static resx:Strings.RemoveViews}"
                IsChecked="{Binding Config.RemoveViews}" />
        </Grid>

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Grid.RowSpan="2"
            Margin="10"
            Background="WhiteSmoke"
            Header="{ x:Static resx:Strings.ViewTypesToDelete}"
            IsEnabled="{Binding Config.RemoveViews}">
            <Grid Margin="0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1 -->
                <CheckBox
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.All}"
                    IsThreeState="True"
                    IsChecked="{Binding All}" />

                <!-- 2 -->
                <CheckBox
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.ThreeDViews}"
                    IsChecked="{Binding ThreeDViews}" />

                <!-- 3 -->
                <CheckBox
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.Details}"
                    IsChecked="{Binding Details}" />

                <!-- 4 -->
                <CheckBox
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.Renderings}"
                    IsChecked="{Binding Renderings}" />

                <!-- 5 -->
                <CheckBox
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.ColumnsSchedules}"
                    IsChecked="{Binding ColumnSchedules}" />

                <!-- 6 -->
                <CheckBox
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.Legends}"
                    IsChecked="{Binding Legends}" />

                <!-- 7 -->
                <CheckBox
                    Grid.Row="6"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.Walkthroughs}"
                    IsChecked="{Binding Walkthroughs}" />

                <!-- 8 -->
                <CheckBox
                    Grid.Row="7"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.AreaPlans}"
                    IsChecked="{Binding AreaPlans}" />

                <!-- 9 -->
                <CheckBox
                    Grid.Row="8"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.EngineeringPlans}"
                    IsChecked="{Binding EngineeringPlans}" />

                <!-- 10 -->
                <CheckBox
                    Grid.Row="9"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.CeilingPlans}"
                    IsChecked="{Binding CeilingPlans}" />

                <!-- 11 -->
                <CheckBox
                    Grid.Row="10"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.FloorPlans}"
                    IsChecked="{Binding FloorPlans}" />

                <!-- 12 -->
                <CheckBox
                    Grid.Row="11"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.Sections}"
                    IsChecked="{Binding Sections}" />

                <!-- 13 -->
                <CheckBox
                    Grid.Row="12"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.Schedules}"
                    IsChecked="{Binding Schedules}" />

                <!-- 14 -->
                <CheckBox
                    Grid.Row="13"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.Elevations}"
                    IsChecked="{Binding Elevations}" />

                <!-- 15 -->
                <CheckBox
                    Grid.Row="14"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="{ x:Static resx:Strings.DraftingViews}"
                    IsChecked="{Binding DraftingViews}" />
            </Grid>
        </GroupBox>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            Width="100"
            Height="25"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="10 0"
            Content="OK"
            Click="Ok_OnClick" />
    </Grid>
</Window>