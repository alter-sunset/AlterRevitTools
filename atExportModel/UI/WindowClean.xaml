<Window x:Class="AlterTools.atExportModel.UI.WindowClean"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AlterTools.atExportModel.UI"
        mc:Ignorable="d"
        Title="ViewModelClean"
        Height="400"
        Width="550"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="10 30">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- 1 -->
            <CheckBox
                Grid.Row="0"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить неиспользуемые элементы"
                IsChecked="{Binding Config.Purge}" />

            <!-- 2 -->
            <CheckBox
                Grid.Row="1"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить связи САПР"
                IsChecked="{Binding Config.RemoveLinkedCad}" />

            <!-- 3 -->
            <CheckBox
                Grid.Row="2"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить связи RVT"
                IsChecked="{Binding Config.RemoveLinkedRvt}" />

            <!-- 4 -->
            <CheckBox
                Grid.Row="3"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить неразмещённые помещения"
                IsChecked="{Binding Config.RemoveOrphanedRooms}" />

            <!-- 5 -->
            <CheckBox
                Grid.Row="4"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить пустые рабочие наборы"
                IsChecked="{Binding Config.RemoveEmptyWorksets}" />

            <!-- 6 -->
            <CheckBox
                Grid.Row="5"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить все листы"
                IsChecked="{Binding Config.RemoveSheets}" />

            <!-- 7 -->
            <CheckBox
                Grid.Row="6"
                Margin="10 0"
                VerticalAlignment="Center"
                Content="Удалить выбранные типы видов:"
                IsChecked="{Binding Config.RemoveViews}" />
        </Grid>

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Grid.RowSpan="2"
            Margin="10"
            Background="WhiteSmoke"
            Header="Типы видов для удаления"
            IsEnabled="{Binding Config.RemoveViews}">
            <Grid Margin="0 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1 -->
                <CheckBox
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Все"
                    IsThreeState="True"
                    IsChecked="{Binding All}" />

                <!-- 2 -->
                <CheckBox
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="3D виды"
                    IsChecked="{Binding ThreeDViews}" />

                <!-- 3 -->
                <CheckBox
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Виды узлов"
                    IsChecked="{Binding Details}" />

                <!-- 4 -->
                <CheckBox
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Визуализация"
                    IsChecked="{Binding Renderings}" />

                <!-- 5 -->
                <CheckBox
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Графические спецификации колонн"
                    IsChecked="{Binding ColumnSchedules}" />

                <!-- 6 -->
                <CheckBox
                    Grid.Row="5"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Легенды"
                    IsChecked="{Binding Legends}" />

                <!-- 7 -->
                <CheckBox
                    Grid.Row="6"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Обходы"
                    IsChecked="{Binding Walkthroughs}" />

                <!-- 8 -->
                <CheckBox
                    Grid.Row="7"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы зонирования"
                    IsChecked="{Binding AreaPlans}" />

                <!-- 9 -->
                <CheckBox
                    Grid.Row="8"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы несущих конструкций"
                    IsChecked="{Binding EngineeringPlans}" />

                <!-- 10 -->
                <CheckBox
                    Grid.Row="9"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы потолков"
                    IsChecked="{Binding CeilingPlans}" />

                <!-- 11 -->
                <CheckBox
                    Grid.Row="10"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Планы этажей"
                    IsChecked="{Binding FloorPlans}" />

                <!-- 12 -->
                <CheckBox
                    Grid.Row="11"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Разрезы"
                    IsChecked="{Binding Sections}" />

                <!-- 13 -->
                <CheckBox
                    Grid.Row="12"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Спецификации"
                    IsChecked="{Binding Schedules}" />

                <!-- 14 -->
                <CheckBox
                    Grid.Row="13"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Фасады"
                    IsChecked="{Binding Elevations}" />

                <!-- 15 -->
                <CheckBox
                    Grid.Row="14"
                    VerticalAlignment="Center"
                    Margin="10 0"
                    Content="Чертёжные виды"
                    IsChecked="{Binding DraftingViews}" />
            </Grid>
        </GroupBox>

        <Button
            Grid.Row="1"
            Grid.Column="0"
            Width="100"
            Height="25"
            VerticalAlignment="Center"
            HorizontalAlignment="Right"
            Margin="10 0"
            Content="OK"
            Click="Ok_OnClick" />
    </Grid>
</Window>