<Window x:Class="AlterTools.atExportModel.UI.WindowMain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:resx="clr-namespace:AlterTools.Resources;assembly=Resources"
        xmlns:local="clr-namespace:AlterTools.atExportModel.UI"
        xmlns:utils="clr-namespace:AlterTools.atExportModel.Utils"
        xmlns:enums="clr-namespace:AlterTools.atExportModel.Enums"
        mc:Ignorable="d"
        Title="{x:Static resx:Strings.ModelsExport}"
        Height="600"
        Width="900"
        ResizeMode="NoResize">
    <Window.InputBindings>
        <!-- The CommandParameter feeds the real UI selection list to your backend -->
        <KeyBinding Key="Delete"
                    Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=FilesListBox}" />
    </Window.InputBindings>

    <Grid>
        <Grid.Resources>
            <utils:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="210" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Header="{x:Static resx:Strings.ExportParameters}"
            Margin="10 "
            Background="WhiteSmoke">
            <Grid
                Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="NWC"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ExportNWC}" />
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    Width="120"
                    Height="25"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="{x:Static resx:Strings.ExportSettings}"
                    Command="{Binding SettingsNWCCommand}" />

                <CheckBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="IFC"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ExportIFC}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    Width="120"
                    Height="25"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="{x:Static resx:Strings.ExportSettings}"
                    Command="{Binding SettingsIFCCommand}" />

                <CheckBox
                    x:Name="RvtCheckBox"
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="RVT"
                    IsChecked="{Binding ExportRVT}" />
                <RadioButton
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin=" 5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    GroupName="ModelType"
                    Content="{x:Static resx:Strings.Transmit}"
                    IsChecked="{Binding RvtExportMode,
                        Mode=TwoWay,
                        Converter={StaticResource EnumToBooleanConverter},
                        ConverterParameter={x:Static enums:RvtExportMode.Transmit}}" />
                <RadioButton
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin=" -30 5 5 5 "
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    GroupName="ModelType"
                    Content="{x:Static resx:Strings.AsCM}"
                    IsChecked="{Binding RvtExportMode,
                        Mode=TwoWay,
                        Converter={StaticResource EnumToBooleanConverter},
                        ConverterParameter={x:Static enums:RvtExportMode.CentralModel}}" />

                <CheckBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Content="{x:Static resx:Strings.Clean}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding CleanModel}"
                    IsEnabled="{Binding IsChecked, ElementName=RvtCheckBox}" />
                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="5"
                    Width="120"
                    Height="25"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="{x:Static resx:Strings.CleanSettings}"
                    Command="{Binding SettingsCleanCommand}"
                    IsEnabled="{Binding IsChecked, ElementName=RvtCheckBox}" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="10"
            Background="WhiteSmoke">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="{x:Static resx:Strings.ViewName}" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Margin="10"
                    Height="25"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding ViewName}" />

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="#999999" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="{x:Static resx:Strings.FolderNWC}" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    Height="25"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding FolderPathNWC}"
                    IsEnabled="{Binding ExportNWC}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    Height="25"
                    Width="100"
                    Content="{x:Static resx:Strings.Browse}"
                    Command="{Binding BrowseFolderNWCCommand}"
                    IsEnabled="{Binding ExportNWC}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="{x:Static resx:Strings.FolderIFC}" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10"
                    Height="25"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding FolderPathIFC}"
                    IsEnabled="{Binding ExportIFC}" />
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Height="25"
                    Width="100"
                    Content="{x:Static resx:Strings.Browse}"
                    Command="{Binding BrowseFolderIFCCommand}"
                    IsEnabled="{Binding ExportIFC}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="{x:Static resx:Strings.FolderRVT}" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="10"
                    Height="25"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Text="{Binding FolderPathRVT}"
                    IsEnabled="{Binding ExportRVT}" />
                <Button
                    Grid.Row="3"
                    Grid.Column="2"
                    Height="25"
                    Width="100"
                    Content="{x:Static resx:Strings.Browse}"
                    Command="{Binding BrowseFolderRVTCommand}"
                    IsEnabled="{Binding ExportRVT}" />
            </Grid>
        </GroupBox>

        <ListBox
            x:Name="FilesListBox"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10 "
            ItemsSource="{Binding InputFiles}"
            SelectionMode="Extended" />

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Margin="0 5 5 5"
                Content="{x:Static resx:Strings.Load}"
                Height="30"
                Width="100"
                HorizontalAlignment="Left"
                Command="{Binding LoadCommand}" />

            <Button
                Grid.Column="2"
                Margin="5 5"
                Content="{x:Static resx:Strings.Import}"
                Height="30"
                Width="100"
                HorizontalAlignment="Right"
                Command="{Binding ImportCommand}" />
            <Button
                Grid.Column="3"
                Margin="5 5"
                Content="{x:Static resx:Strings.Export}"
                Height="30"
                Width="100"
                HorizontalAlignment="Left"
                Command="{Binding ExportCommand}" />

            <Button
                Grid.Column="5"
                Margin="5 5 10 5"
                Content="{x:Static resx:Strings.Start}"
                Height="30"
                Width="100"
                HorizontalAlignment="Right"
                Command="{Binding ExecuteCommand}" />
        </Grid>
    </Grid>
</Window>