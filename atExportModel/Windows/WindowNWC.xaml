<Window x:Class="AlterTools.atExportModel.Windows.WindowNWC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AlterTools.atExportModel.Windows"
        mc:Ignorable="d"
        Title="WindowNWC" Height="600" Width="450">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="120" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1 -->
        <TextBlock Grid.Row="0"
                   VerticalAlignment="Center"
                   Text="Конвертировать идентификаторы объектов" />

        <CheckBox Grid.Row="0"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ExportElementIds}" />

        <!-- 2 -->
        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center"
                   Text="Конвертировать параметры объектов" />

        <ComboBox Grid.Row="1"
                  Grid.Column="1"
                  Width="100"
                  SelectedIndex="0"
                  HorizontalAlignment="Left"
                  Margin="5">
            <ComboBoxItem Content="Все" />
            <ComboBoxItem Content="Только общие" />
            <ComboBoxItem Content="Нет" />
        </ComboBox>

        <!-- 3 -->
        <TextBlock Grid.Row="2"
                   VerticalAlignment="Center"
                   Text="Координаты" />

        <ComboBox Grid.Row="2"
                  Grid.Column="1"
                  Width="100"
                  SelectedIndex="0"
                  HorizontalAlignment="Left"
                  Margin="5">
            <ComboBoxItem Content="Общие" />
            <ComboBoxItem Content="Общие + Shared" />
            <ComboBoxItem Content="Internal" />
        </ComboBox>

        <!-- 4 -->
        <TextBlock Grid.Row="3"
                   VerticalAlignment="Center"
                   Text="Коэффициент фасетизации" />

        <TextBox Grid.Row="3"
                 Grid.Column="1"
                 HorizontalAlignment="Left"
                 Margin="5"
                 Width="100"
                 VerticalContentAlignment="Center"
                 Text="{Binding FacetingFactor}" />

        <!-- 5 -->
        <TextBlock Grid.Row="4"
                   VerticalAlignment="Center"
                   Text="Преобразовать URL-адреса" />

        <CheckBox Grid.Row="4"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ExportUrls}" />

        <!-- 6 -->
        <TextBlock Grid.Row="5"
                   VerticalAlignment="Center"
                   Text="Преобразовать источники света" />

        <CheckBox Grid.Row="5"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5" />

        <!-- 7 -->
        <TextBlock Grid.Row="6"
                   VerticalAlignment="Center"
                   Text="Преобразовать помещение как атрибут" />

        <CheckBox Grid.Row="6"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ExportRoomAsAttribute}" />

        <!-- 8 -->
        <TextBlock Grid.Row="7"
                   VerticalAlignment="Center"
                   Text="Конвертировать параметры объектов" />

        <CheckBox Grid.Row="7"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ConvertElementProperties}" />

        <!-- 9 -->
        <TextBlock Grid.Row="8"
                   VerticalAlignment="Center"
                   Text="Преобразовать связанные CAD файлы" />

        <CheckBox Grid.Row="8"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ConvertLinkedCADFormats}" />

        <!-- 10 -->
        <TextBlock Grid.Row="9"
                   VerticalAlignment="Center"
                   Text="Преобразовать связанные файлы" />

        <CheckBox Grid.Row="9"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ExportLinks}" />

        <!-- 11 -->
        <TextBlock Grid.Row="10"
                   VerticalAlignment="Center"
                   Text="Преобразовать элементы конструкции" />

        <CheckBox Grid.Row="10"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ExportParts}" />

        <!-- 12 -->
        <TextBlock Grid.Row="11"
                   VerticalAlignment="Center"
                   Text="Проверять и находить отсутствующие материалы" />

        <CheckBox Grid.Row="11"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding FindMissingMaterials}" />

        <!-- 13 -->
        <TextBlock Grid.Row="12"
                   VerticalAlignment="Center"
                   Text="Разделить файл на уровни" />

        <CheckBox Grid.Row="12"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding DivideFileIntoLevels}" />

        <!-- 14 -->
        <TextBlock Grid.Row="13"
                   VerticalAlignment="Center"
                   Text="Экспорт" />

        <ComboBox Grid.Row="13"
                  Grid.Column="1"
                  HorizontalAlignment="Left"
                  Margin="5"
                  Width="100"
                  SelectedIndex="0">
            <ComboBoxItem Content="NWD" />
            <ComboBoxItem Content="NWC" />
        </ComboBox>

        <!-- 15 -->
        <TextBlock Grid.Row="14"
                   VerticalAlignment="Center"
                   Text="Экспортировать геометрию помещения" />

        <CheckBox Grid.Row="14"
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="5"
                  IsChecked="{Binding ExportRoomGeometry}" />

        <!-- OK Button -->
        <Button Grid.Row="15"
                Grid.ColumnSpan="2"
                Content="OK"
                Width="114"
                HorizontalAlignment="Right"
                Margin="0 10 0 0"
                Click="Ok_OnClick" />
    </Grid>
</Window>