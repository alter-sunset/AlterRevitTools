<Window x:Class="AlterTools.atExportModel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:AlterTools.atExportModel"
        mc:Ignorable="d"
        Title="Models Export"
        Height="450"
        Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="180" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Header="Параметры экспорта"
            Margin="10 "
            Background="WhiteSmoke">
            <Grid
                Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Content="NWC"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ExportNWC}" />
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5"
                    Width="120"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="Настройки экспорта"
                    Click="Settings_Click" />

                <CheckBox
                    Grid.Row="1"
                    Grid.Column="0"
                    Content="IFC"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding ExportIFC}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5"
                    Width="120"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="Настройки экспорта"
                    Command="{Binding ConfigIFC}" />

                <CheckBox
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="RVT"
                    IsChecked="{Binding ExportRvt}" />
                <RadioButton
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin=" 5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="для передачи"
                    IsChecked="{Binding AsTransmit}" />
                <RadioButton
                    Grid.Row="2"
                    Grid.Column="2"
                    Margin=" -30 5 5 5 "
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="как ЦМ"
                    Command="{Binding AsCentralModel}" />

                <CheckBox
                    Grid.Row="3"
                    Grid.Column="0"
                    Content="Очистка"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding CleanModel}"
                    IsEnabled="{Binding ExportRvt}" />
                <Button
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="5"
                    Width="120"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Content="Настройки очистки"
                    Command="{Binding ConfigClean}"
                    IsEnabled="{Binding ExportRvt}" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="10"
            Background="WhiteSmoke">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="Имя вида" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="10"
                    VerticalContentAlignment="Center"
                    Text="Navisworks" />

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    VerticalAlignment="Bottom"
                    Height="1"
                    Background="#999999" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="Папка NWC" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10"
                    VerticalContentAlignment="Center"
                    Text="C:/Docs/NWC" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="Папка IFC" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10"
                    VerticalContentAlignment="Center"
                    Text="C:/Docs/IFC" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="10"
                    Text="Папка RVT" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="10"
                    VerticalContentAlignment="Center"
                    Text="C:/Docs/RVT" />
            </Grid>
        </GroupBox>

        <ListBox
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10 ">
        </ListBox>

        <Grid
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="10 0 0 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Margin="0 5 5 5"
                Content="Загрузить">
            </Button>
            <Button
                Grid.Column="2"
                Margin="5 5"
                Content="Импорт">
            </Button>
            <Button
                Grid.Column="3"
                Margin="5 5"
                Content="Экспорт">
            </Button>
            <Button
                Grid.Column="5"
                Margin="5 5 10 5"
                Content="Запуск">
            </Button>
        </Grid>
    </Grid>
</Window>